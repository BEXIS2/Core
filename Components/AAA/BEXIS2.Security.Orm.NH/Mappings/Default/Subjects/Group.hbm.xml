<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2" assembly="BEXIS2.Security.Entities" namespace="BEXIS2.Security.Entities.Subjects">
  <union-subclass xmlns="urn:nhibernate-mapping-2.2" name="Group" table="Groups" extends="Subject" dynamic-update="true">
    <property name="Description" type="String">
      <column name="Description" sql-type="text" />
    </property>
    <property name="IsValid" type="yes_no" />
    <property name="IsSystemGroup" type="yes_no" />
    <set name="Users" table="Users_Groups" cascade="save-update" inverse="true" lazy="true">
      <key column="GroupRef" />
      <many-to-many column="UserRef" class="BEXIS2.Security.Entities.Subjects.User, BEXIS2.Security.Entities" />
    </set>
	  <property name="CreationDate" type="DateTime" />
	  <property name="ModificationDate" type="DateTime" />
  </union-subclass>
</hibernate-mapping>