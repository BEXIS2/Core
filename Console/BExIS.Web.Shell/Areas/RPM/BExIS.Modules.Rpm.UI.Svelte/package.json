{
  "name": "@bexis2/bexis2-rpm-ui",
  "version": "0.3.0",
  "private": false,
  "description": "Everything you need to build a Svelte project, powered by [`create-svelte`](https://github.com/sveltejs/kit/tree/master/packages/create-svelte).",
  "keywords": [
    "bexis2",
    "library"
  ],
  "homepage": "https://github.com/BEXIS2/Core#readme",
  "bugs": {
    "url": "https://github.com/BEXIS2/Core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BEXIS2/Core.git"
  },
  "license": "ISC",
  "author": "David Schöne",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./dist/index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    }
  },
  "main": "./src/lib/index.d.ts",
  "types": "./src/lib/index.d.ts",
  "directories": {
    "test": "tests"
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "scripts": {
    "dev": "pnpm vite --filter @bexis2/bexis2-rpm-ui dev",
    "build": "pnpm vite --filter @bexis2/bexis2-rpm-ui build --logLevel error",
    "preview": "pnpm vite --filter @bexis2/bexis2-rpm-ui preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "create patch": "npx patch-package @sveltejs/kit",
    "build package": "svelte-kit sync && svelte-package --watch",
    "check outdated": "pnpm outdated",
    "upgrade all": "pnpm ncu --upgrade",
    "0.npm login": "pnpm login",
    "1.npm - init": "pnpm init --scope bexis2",
    "2.npm - package": "svelte-package",
    "3.npm - publish": "pnpm publish --access public"
  },
  "dependencies": {
    "@bexis2/bexis2-core-ui": "0.4.83",
    "@floating-ui/dom": "1.7.6",
    "papaparse": "5.5.2",
    "svelte-fa": "4.0.4"
  },
  "module": "./src/lib/index.ts"
}