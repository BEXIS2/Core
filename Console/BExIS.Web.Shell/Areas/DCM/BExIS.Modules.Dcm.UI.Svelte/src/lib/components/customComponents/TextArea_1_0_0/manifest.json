        "variables": {
          "variable": [
            {
              "name": "Text Area",
              "description": "Text area input",
              "type": "string",
              "format": "",
              "target_variable": "text_field",
              "allowregex_input": true,
              "allowregex_output": true,
              "is_input": true,
              "is_output": true,
              "default_value": {
                "type": "string",
                "value": ""
              }
            }
          ]
        }
      }
    ]
  }
