              "name": "Disable",
              "description": "Disable the date range checker",
              "type": "boolean",
              "target_variable": "disable",
              "default_value": {
                "type": "boolean",
                "value": false
              }
            }
          ]
        },
        "variables": {
          "variable": [
            {
              "name": "Start Date",
              "description": "Start date",
              "type": "string",
              "format": "",
