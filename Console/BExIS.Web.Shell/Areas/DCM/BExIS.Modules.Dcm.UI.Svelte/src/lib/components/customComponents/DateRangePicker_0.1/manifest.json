        "variables": {
          "variable": [
            {
              "name": "Start Date",
              "description": "Start date",
              "type": "string",
              "target_variable": "startDate",
              "allowregex_input": true,
              "allowregex_output": false,
              "is_input": true,
              "is_output": false,
              "default_value": {
                "type": "string",
                "value": ""
              }
            },
            {
              "name": "End Date",
              "description": "End date",
              "type": "string",
              "target_variable": "endDate",
              "allowregex_input": true,
              "allowregex_output": false,
              "is_input": true,
              "is_output": false,
              "default_value": {
                "type": "string",
                "value": ""
              }
            }
