@{
    ViewBag.Title = "Metadata";
    Layout = "~/Themes/Default/Layouts/_svelteLayout.cshtml";

    long id = 0;
    int version = 0;
    double tag = 0;
    bool useTags = false;

    if (ViewData["id"] != null) { id = Convert.ToInt64(ViewData["id"]); }
    if (ViewData["version"] != null) { version = Convert.ToInt32(ViewData["version"]); }
    if (ViewData["tag"] != null) { tag = Convert.ToDouble(ViewData["tag"]); }
    if (ViewData["useTags"] != null) { useTags = Convert.ToBoolean(ViewData["useTags"]); }


}



<div id="metadata" dataset="@id" version="@version" tag="@tag" useTags="@useTags">
    @Html.Partial("_sveltePage")
</div>