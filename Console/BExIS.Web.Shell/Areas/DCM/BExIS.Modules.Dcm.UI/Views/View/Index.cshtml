@{
    ViewBag.Title = "View";
    Layout = "~/Themes/Default/Layouts/_svelteLayout.cshtml";

    long id = 0;
    long version = -1;

    if (ViewData["id"] != null) { id = Convert.ToInt64(ViewData["id"]); }

    if (ViewData["version"] != null) { version = Convert.ToInt64(ViewData["version"]); }

    string bioSchemaInfos = "";
    if (ViewData["bioSchema"] != null)
    {
        bioSchemaInfos = ViewData["bioSchema"].ToString();
    }

}

<script type="application/ld+json">
    @Html.Raw(bioSchemaInfos)
</script>

<div id="view" dataset="@id" version="@version">

    @Html.Partial("_sveltePage")
</div>