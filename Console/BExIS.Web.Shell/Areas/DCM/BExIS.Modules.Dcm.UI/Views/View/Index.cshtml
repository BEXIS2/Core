@{

    Layout = "~/Themes/Default/Layouts/_svelteLayout.cshtml";

    long id = 0;
    long version = -1;
    long tag = 0;
    string entity = "dataset";

    if (ViewData["id"] != null) { id = Convert.ToInt64(ViewData["id"]); }

    if (ViewData["version"] != null) { version = Convert.ToInt64(ViewData["version"]); }

    if (ViewData["tag"] != null) { version = Convert.ToInt64(ViewData["tag"]); }

    if (ViewData["entity"] != null) { entity = ViewData["entity"].ToString(); }

    ViewBag.Title = String.Format("View {0} ({1})",entity.Capitalize(),id);

    string bioSchemaInfos = "";
    if (ViewData["bioSchema"] != null)
    {
        bioSchemaInfos = ViewData["bioSchema"].ToString();
    }

}

<script type="application/ld+json">
    @Html.Raw(bioSchemaInfos)
</script>

<div id="view" dataset="@id" version="@version" tag="@tag"  >

    @Html.Partial("_sveltePage")
</div>